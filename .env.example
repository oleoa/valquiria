# Strutura Email Gateway — envio dos formulários (app/forms/*) e do e-mail de compra
# (app/api/webhooks/stripe). Ver EMAIL-GATEWAY.md. Peça a chave do projeto ao mantenedor do
# gateway (Leonardo) e cole o valor real em .env.local (que NÃO é versionado). Na Vercel,
# configure a mesma variável em Settings → Environment Variables (Production + Preview).
EMAIL_GATEWAY_KEY=

# (Opcional) Cópia das respostas dos formulários para uma caixa monitorada — redundância
# caso a entrega principal para o e-mail da Valquiria falhe silenciosamente (o gateway não
# confirma entrega). Deixe vazio para não enviar cópia. Server-side apenas (sem NEXT_PUBLIC).
EMAIL_COPIA=

# Stripe — webhook de compras (app/api/webhooks/stripe), que avisa a Valquiria por e-mail a
# cada compra. Crie no painel do Stripe (modo LIVE): uma Restricted key com leitura de
# Checkout Sessions → STRIPE_SECRET_KEY; e um endpoint de webhook apontando para
# https://valquiriaabreu.com/api/webhooks/stripe (eventos checkout.session.completed,
# checkout.session.async_payment_succeeded e invoice.paid) → o Signing secret é o
# STRIPE_WEBHOOK_SECRET. Configure as duas também na Vercel (Production + Preview).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Banco Neon Postgres (projeto "Valquiria") — onde as respostas dos formulários (app/forms/*)
# são gravadas via lib/forms/salvar.ts (lib/db/cliente.ts). Use a connection string POOLED
# (host ...-pooler...), com sslmode=require — copie do painel do Neon e cole em .env.local (que
# NÃO é versionado). Na Vercel, configure a mesma variável em Production + Preview.
DATABASE_URL=

# Área interna protegida (/dashboard) — login por senha única (sem provedor externo). Protege
# TODO o /dashboard, inclusive a página de respostas dos formulários (/dashboard/respostas).
# Lógica em lib/auth/sessao.ts + middleware.ts. São duas variáveis:
#  - ADMIN_PASSWORD: a senha de acesso (escolha uma forte e guarde com a Valquiria).
#  - ADMIN_SESSION_SECRET: string aleatória longa que ASSINA o cookie de sessão (não é a senha).
#    Gere um valor com, por ex.: `openssl rand -hex 32` (ou `node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"`).
# Cole os valores reais em .env.local (que NÃO é versionado). Na Vercel, configure as duas em
# Production + Preview. Trocar o ADMIN_SESSION_SECRET invalida as sessões/logins já abertos.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
